# PostgreSQL database connection used by the API server and Drizzle.
# Example format only. Never commit a real password/connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# API server port
PORT=3001

# Frontend Vite settings when running the frontend separately
# Run the frontend on another port, e.g. PORT=5173 for its process.
BASE_PATH=/
